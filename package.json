{
  "name": "1-more-thing",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "cargo run --locked",
    "build:client": "vite build && node scripts/build-service-worker.mjs && node scripts/compress.mjs",
    "build": "npm run build:client && cargo build --release --locked",
    "start": "./target/release/and1",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "check": "tsc --noEmit && cargo fmt --check && cargo clippy --locked --all-targets -- -D warnings",
    "auth:hash": "cargo run --quiet --locked -- hash-password",
    "benchmark": "node scripts/benchmark.mjs",
    "test:docker": "docker build -t and1:test . && node tests/docker-smoke.mjs"
  },
  "dependencies": {
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@preact/preset-vite": "^2.10.2",
    "@tailwindcss/postcss": "4.3.4",
    "@types/node": "24.19.2",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  },
  "type": "module"
}
